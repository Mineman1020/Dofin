rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9._-]+$');
    }

    function isValidParty(data) {
      return data.code is string && data.code.size() >= 4 && data.code.size() <= 12
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.purpose in ['study', 'work', 'coding', 'reading', 'creative', 'general']
        && data.createdBy is string
        && data.createdByName is string;
    }

    function isValidMember(data) {
      return data.userId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.totalFocusMinutes is number && data.totalFocusMinutes >= 0
        && data.completedSessions is number && data.completedSessions >= 0
        && data.currentStatus in ['focusing', 'break', 'idle'];
    }

    function isValidMessage(data) {
      return data.partyId is string
        && data.senderId is string
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 60
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt is string;
    }

    function isValidPoll(data) {
      return data.partyId is string
        && data.question is string && data.question.size() > 0 && data.question.size() <= 200
        && data.createdBy is string
        && data.createdByName is string
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
        && data.status in ['active', 'closed']
        && data.createdAt is string;
    }

    function isValidAccount(data) {
      return data.username is string && data.username.size() >= 5 && data.username.size() <= 80
        && data.username.matches('^[a-zA-Z0-9._-]+@dek$')
        && data.passwordHash is string && data.passwordHash.size() == 64
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User accounts collection for cross-device authentication and sync
    // 101% Safe & Hardened:
    // - Scrape protection: 'list' is completely forbidden to prevent unauthorized enumeration of user accounts
    // - Direct lookup: 'get' is permitted for single document access by valid accountId
    // - Schema integrity: 'create' requires valid schema (username ending with @dek, 64-char SHA-256 hash, display name)
    // - Credential immutability: 'update' strictly prevents altering another user's username or password hash
    // - Deletion is forbidden to prevent accidental or malicious account loss
    match /accounts/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if false;
      allow create: if isValidId(accountId) && isValidAccount(request.resource.data);
      allow update: if isValidId(accountId)
        && request.resource.data.username == resource.data.username
        && request.resource.data.passwordHash == resource.data.passwordHash;
      allow delete: if false;
    }

    // Party collection
    match /parties/{partyId} {
      allow read: if true;
      allow create: if isValidParty(request.resource.data);
      allow update: if isValidParty(request.resource.data) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']);
      allow delete: if resource.data.createdBy == request.resource.data.createdBy;

      // Party Members subcollection for leaderboard & live status
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isValidMember(request.resource.data);
        allow delete: if true;
      }

      // Party Messages subcollection for real-time chat
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidMessage(request.resource.data);
        allow update, delete: if resource.data.senderId == request.resource.data.senderId;
      }

      // Party Polls subcollection for decision making & group tests
      match /polls/{pollId} {
        allow read: if true;
        allow create: if isValidPoll(request.resource.data);
        allow update: if true;
        allow delete: if resource.data.createdBy == request.resource.data.createdBy;
      }
    }

    // Connection test document
    match /test/{docId} {
      allow get: if true;
      allow create, update: if true;
      allow list, delete: if false;
    }
  }
}
